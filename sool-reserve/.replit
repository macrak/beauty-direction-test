modules = ["nodejs-20", "postgresql-16"]
run = "npm install && npm run setup && npm run dev"

[env]
UPLOAD_DIR = "./uploads"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
build = ["sh", "-c", "npm install && npm run db:migrate && npm run build"]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "cloudrun"
