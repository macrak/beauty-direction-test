# PostgreSQL 연결 문자열 (Replit: Database 탭에서 자동 생성되는 DATABASE_URL 사용)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sool"
# 세션 서명 키 — 32자 이상 임의 문자열로 반드시 교체
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# 최초 시드 시 생성되는 최고관리자 계정 (최초 로그인 후 변경 권장)
ADMIN_EMAIL="admin@soolreserve.local"
ADMIN_PASSWORD="SoolReserve!2026"
# 업로드 이미지 저장 경로
UPLOAD_DIR="./uploads"
# 실제 PG / 성인인증 키 (비워두면 Mock 공급자만 사용됨 — 실결제 불가)
PG_SECRET_KEY=""
AGE_VERIFICATION_SECRET=""
